PokedexHeader {
    height: 1;
    dock: top;
    background: $header-bar;
    color: $header-text;
}

.hint-line {
    color: $text-muted;
}

.generation {
    height: 1;
    width: auto;
    margin-left: 1;
}

#header-title, #header-subtitle {
    width: auto;
    margin: 0 1;
}

#header-title, #header-count {
    text-style: bold;
}

#header-count {
    width: 1fr;
    text-align: right;
}

FilterBar {
    layout: grid;
    grid-size: 5 1;
    grid-columns: 30 1fr 1fr 1fr 1fr;
    height: 3;
}

#results {
    height: 1fr;
}

TypeBadge {
    width: 10;
    text-align: center;
}

ExtendedTable {
    background: $background;
    background-tint: 0%;
}

ExtendedTable > .datatable--header {
    background: $background;
    text-style: bold;
    color: $text-muted;
    background-tint: 0%;
}

ExtendedTable > .datatable--even-row {
    background: $background;
}

ExtendedTable > .datatable--header-hover, ExtendedTable > .datatable--header-cursor {
    background: $background;
}

Box {
    border: solid $border-blurred;
}

Box:focus-within {
    border: solid $border;
}
