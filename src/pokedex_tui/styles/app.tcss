PokedexHeader {
    height: 1;
    dock: top;
}

#title, #subtitle {
    width: auto;
    margin: 0 1;
}

#subtitle {
    text-opacity: 75%;
}

#count {
    width: 1fr;
    text-align: right;
}

Search {
    layout: grid;
    grid-size: 5 1;
    grid-columns: 30 1fr 1fr 1fr 1fr;
    height: 3;
}

#results {
    height: 1fr;
}

Box {
    border: teal solid;
}
