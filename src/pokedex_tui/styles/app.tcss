PokedexHeader {
    height: 1;
    dock: top;
}

#header-title, #header-subtitle {
    width: auto;
    margin: 0 1;
}

#header-title, #header-count {
    text-style: bold;
}

#header-count {
    width: 1fr;
    text-align: right;
}

FilterBar {
    layout: grid;
    grid-size: 5 1;
    grid-columns: 30 1fr 1fr 1fr 1fr;
    height: 3;
}

#results {
    height: 1fr;
}

Box {
    border: solid;
}
